{
  "name": "project-aether",
  "private": true,
  "version": "1.0.0",
  "description": "PROJECT AETHER — the cinematic personal universe of Adil Akhtab Abir.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "sync": "tsx scripts/sync-github.ts",
    "readme:assets": "tsx scripts/render-readme-assets.ts",
    "readme:update": "tsx scripts/update-readme.ts",
    "readme:check": "tsx scripts/check-readme.ts",
    "capture": "tsx scripts/capture-previews.ts",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build && npm run readme:check"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-xml-parser": "^5.12.1",
    "globals": "^17.14.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
